{
  "name": "runefile",
  "displayName": "Rune Task Runner",
  "description": "Official Rune task runner support for Runefiles \u2014 diagnostics, completion, go-to-definition, hover, document symbols, and formatting via the embedded `rune lsp` server.",
  "version": "0.0.0",
  "publisher": "rune-task-runner",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/rune-task-runner/rune"
  },
  "bugs": {
    "url": "https://github.com/rune-task-runner/rune/issues"
  },
  "homepage": "https://github.com/rune-task-runner/rune#readme",
  "keywords": [
    "rune",
    "runefile",
    "task runner",
    "lsp",
    "language server"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:runefile"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "runefile",
        "aliases": [
          "Runefile",
          "rune"
        ],
        "filenames": [
          "Runefile",
          ".runefile"
        ],
        "extensions": [
          ".rune"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/runefile.svg",
          "dark": "./icons/runefile.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "runefile",
        "scopeName": "source.rune",
        "path": "./syntaxes/runefile.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Rune",
      "properties": {
        "rune.path": {
          "type": "string",
          "default": "rune",
          "description": "Path to the `rune` executable used to start the language server (`rune lsp`)."
        },
        "rune.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the JSON-RPC traffic between VS Code and the rune language server."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "3.9.2",
    "ovsx": "1.0.2"
  },
  "scripts": {
    "package": "vsce package",
    "publish:vsce": "vsce publish --packagePath",
    "publish:ovsx": "ovsx publish"
  }
}
