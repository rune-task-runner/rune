set default := "greet"

build_dir := "dist"

# Say hello.
greet name="world":
    @echo "hello, {{name}}"

# Build the project.
build: greet
    @echo "building {{build_dir}}..."
    go build ./...

# Deploy with post-mortem diagnostics.
deploy: build && notify || (diagnose "verbose")
    @echo "deploying"
