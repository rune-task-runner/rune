# A reviewed infrastructure change with OpenTofu. `plan` saves the plan to a file, and Rune
# moves that file and its summary into its store under .rune/plans/. `apply` runs only with
# the stored plan, only after a person approved it, and only once.

# Initialize the working directory.
init:
    tofu init -input=false

# Plan the change for one environment and save the plan.
[plan(file="tfplan", summary="tfplan.txt", tool="tofu")]
plan env:enum("staging","prod"): init
    tofu plan -input=false -var env={{quote(env)}} -out=tfplan
    tofu show -no-color tfplan > tfplan.txt

# Apply the reviewed plan.
[applies("plan")]
apply env:enum("staging","prod"):
    tofu apply -input=false "$RUNE_PLAN_FILE"
