# Settings shape a Runefile; a .env file feeds task environments.
# `set export` makes Runefile variables available to bodies as env vars, and
# `set dotenv` loads the values of the file it names (here GREETING). Secrets
# come from the environment, never hard-coded here.
set export
set dotenv := ".env"

app := "demo"

# Print config sourced from a setting (app) and from .env (GREETING).
show:
    @echo "app=$app greeting=${GREETING:-unset}"
