# Dependencies run BEFORE a task; post-hooks (after &&) run AFTER it succeeds.
# Each task runs at most once per invocation, even via multiple paths.

# `build` and `test` run first; `notify` runs after `deploy` succeeds.
deploy: build test && notify
    @echo "deploying"

build:
    @echo "building"

test:
    @echo "testing"

notify:
    @echo "notify: deployed ✓"

# Failure hooks (after ||) run only when the task's own body FAILS —
# post-mortem diagnostics with the failure context in the environment.
flaky: || diagnose
    @echo "checking"
    @exit 3

diagnose:
    @echo "diagnose: $RUNE_FAILED_TASK failed with exit $RUNE_FAILED_EXIT_CODE"
