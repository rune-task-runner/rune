# A CI pipeline as one task with dependencies, plus a gated deploy.
# In CI: `rune ci` (predictable exit codes), or `rune --dry-run ci` to preview.

# The CI gate: lint, test, build must all pass.
ci: lint test build
    @echo "CI passed ✓"

lint:
    @echo "golangci-lint run"

test:
    @echo "go test ./..."

build:
    @echo "go build ./..."

# Deploy is gated: it prompts unless run with --yes (safe for unattended CI/agents).
[confirm("Deploy to production?")]
deploy: ci
    @echo "deploying to production"

# Release gate: exits 2 ("refused") when the window is closed, 0 otherwise.
# Rune exits with the body's own code, so CI can branch on it.
release-gate window="open":
    @[ "{{window}}" != "closed" ] || { echo "release gate: refused (window closed)" >&2; exit 2; }
    @echo "release gate: open"
